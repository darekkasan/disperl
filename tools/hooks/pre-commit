#!/bin/sh
# disperl の pre-commit フック。
#   perl tools/install-hooks.pl で .git/hooks/pre-commit にコピーされます。
#
# 1. 空白エラー（git diff --check）
# 2. .env がステージされていないか
# 3. ステージされた Perl ファイルの構文チェック
# 4. テスト（DISPERL_SKIP_TESTS=1 でスキップ）
#
# Git for Windows の sh には cygwin Perl がいるため、Strawberry Perl の
# prove.bat が見つかったら同じ場所の perl.exe を使います。
set -e

perl_cmd()  { perl "$@"; }
prove_cmd() { prove "$@"; }

if command -v prove.bat >/dev/null 2>&1; then
    bin_dir=$(dirname "$(command -v prove.bat)")
    if [ -x "$bin_dir/perl.exe" ] && [ -f "$bin_dir/prove" ]; then
        perl_cmd()  { "$bin_dir/perl.exe" "$@"; }
        prove_cmd() { "$bin_dir/perl.exe" "$bin_dir/prove" "$@"; }
    fi
fi

if ! git diff --cached --check; then
    echo "pre-commit: trailing whitespace or conflict markers found" >&2
    exit 1
fi

if git diff --cached --name-only | grep -qx '.env'; then
    echo "pre-commit: .env is staged; do not commit it" >&2
    exit 1
fi

status=0
for file in $(git diff --cached --name-only --diff-filter=ACM -- '*.pm' '*.pl' '*.t'); do
    [ -f "$file" ] || continue
    if ! perl_cmd -Ilib -c "$file" >/dev/null 2>&1; then
        echo "pre-commit: syntax error: $file" >&2
        perl_cmd -Ilib -c "$file" || true
        status=1
    fi
done
if [ "$status" -ne 0 ]; then
    exit 1
fi

if [ "$DISPERL_SKIP_TESTS" = "1" ]; then
    echo "pre-commit: tests skipped (DISPERL_SKIP_TESTS=1)"
    exit 0
fi

if ! prove_cmd -l -j4 t; then
    echo "pre-commit: tests failed (skip with DISPERL_SKIP_TESTS=1)" >&2
    exit 1
fi

echo "pre-commit: OK"
exit 0
