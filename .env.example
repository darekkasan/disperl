# .env のテンプレート。コピーして .env を作る（.env は .gitignore 済み）。
# 実際の値は絶対にコミットしないこと。
DISCORD_TOKEN=your-bot-token-here
DISCORD_CHANNEL_ID=000000000000000000

# 省略可。未設定なら Bot のユーザー ID をアプリケーション ID として使う。
# DISCORD_APPLICATION_ID=000000000000000000

# 省略可。OAuth2 の認可コードフローを使う場合（クライアントシークレットは必須ではない）。
# DISCORD_CLIENT_ID=000000000000000000
# DISCORD_CLIENT_SECRET=your-client-secret-here

# 省略可。HTTP インタラクション（Interactions Endpoint URL）を使う場合。
# Developer Portal の「Public Key」を設定する。
# DISCORD_PUBLIC_KEY=your-public-key-here
